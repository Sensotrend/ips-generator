type: install
name: IPS Generator (dev)
description: Development environment for the IPS Generator. Synthetic data only, replay extractor, no LLM.
# DRAFT, untested on cloudplatform.fi. See infra/cloudplatform/README.md for what to verify.

settings:
  fields:
    - name: ghcrOwnerRepo
      caption: GHCR image prefix (lowercase owner/repo)
      type: string
      default: sensotrend/ips-generator
    - name: ghcrUser
      caption: GitHub user for pulling images (private packages)
      type: string
    - name: ghcrToken
      caption: GitHub token with read:packages
      type: string
      inputType: password
    - name: tag
      caption: Image tag to start with
      type: string
      default: dev
    - name: pgPassword
      caption: Postgres password
      type: string
      inputType: password
    - name: s3Secret
      caption: MinIO secret key
      type: string
      inputType: password

nodes:
  - nodeGroup: postgres
    nodeType: docker
    image: postgres:18.6-bookworm
    count: 1
    cloudlets: 16
    env:
      POSTGRES_USER: ips
      POSTGRES_PASSWORD: ${settings.pgPassword}
      POSTGRES_DB: ips
    volumes:
      - /var/lib/postgresql
  - nodeGroup: redis
    nodeType: docker
    image: redis:8-bookworm
    count: 1
    cloudlets: 8
  - nodeGroup: minio
    nodeType: docker
    image: pgsty/minio:RELEASE.2026-08-04T00-00-00Z
    cmd: server /data --console-address :9001
    count: 1
    cloudlets: 8
    env:
      MINIO_ROOT_USER: ips-dev-access
      MINIO_ROOT_PASSWORD: ${settings.s3Secret}
    volumes:
      - /data
  - nodeGroup: matchbox
    nodeType: docker
    image: ${settings.ghcrOwnerRepo}-matchbox:${settings.tag}
    registry:
      url: ghcr.io
      user: ${settings.ghcrUser}
      password: ${settings.ghcrToken}
    count: 1
    cloudlets: 32          # about 4 GB at most; Matchbox needs about 3 GB
    volumes:
      - /database
  # api, worker and web are configured below, once the other nodes' IPs are known.
  - nodeGroup: api
    nodeType: docker
    image: ${settings.ghcrOwnerRepo}-backend:${settings.tag}
    registry:
      url: ghcr.io
      user: ${settings.ghcrUser}
      password: ${settings.ghcrToken}
    count: 1
    cloudlets: 16
    startServiceOnCreation: false
  - nodeGroup: worker
    nodeType: docker
    image: ${settings.ghcrOwnerRepo}-backend:${settings.tag}
    registry:
      url: ghcr.io
      user: ${settings.ghcrUser}
      password: ${settings.ghcrToken}
    cmd: python -m app.worker
    count: 1
    cloudlets: 16
    startServiceOnCreation: false
  - nodeGroup: web
    nodeType: docker
    image: ${settings.ghcrOwnerRepo}-web:${settings.tag}
    registry:
      url: ghcr.io
      user: ${settings.ghcrUser}
      password: ${settings.ghcrToken}
    count: 1
    cloudlets: 4
    extip: true            # public entry point; check how the platform maps the environment domain
    startServiceOnCreation: false

globals:
  appEnv:
    APP_ENV: development
    EXTRACTOR: replay
    AUTH_MODE: dev
    TERMINOLOGY_MODE: deterministic
    VALIDATE_WITH_MATCHBOX: "true"
    DATABASE_URL: postgresql://ips:${settings.pgPassword}@${nodes.postgres.master.intIP}:5432/ips
    REDIS_URL: redis://${nodes.redis.master.intIP}:6379/0
    S3_ENDPOINT_URL: http://${nodes.minio.master.intIP}:9000
    S3_ACCESS_KEY: ips-dev-access
    S3_SECRET_KEY: ${settings.s3Secret}
    S3_BUCKET: ips-documents
    MATCHBOX_URL: http://${nodes.matchbox.master.intIP}:8080/matchboxv3/fhir

onInstall:
  # MinIO treats a top-level directory in /data as a bucket.
  - cmd[minio]: mkdir -p /data/ips-documents
  - environment.control.AddContainerEnvVars:
      nodeGroup: api
      vars: ${globals.appEnv}
  - environment.control.AddContainerEnvVars:
      nodeGroup: worker
      vars: ${globals.appEnv}
  - environment.control.AddContainerEnvVars:
      nodeGroup: web
      vars:
        API_UPSTREAM: ${nodes.api.master.intIP}:8000
  - start: [api, worker, web]
