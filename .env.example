# Copy to .env and fill in. Never commit .env.
# Backend reads these from the process environment; docker compose uses them via
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
# Values here are placeholders / dev-only defaults.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider (PLAN §7.1 D-5): anthropic | bedrock | vertex ---
# anthropic = first-party Claude API, synthetic data only. bedrock/vertex are not implemented yet.
LLM_PROVIDER=anthropic

# --- Anthropic (required for LLM pipeline steps) ---
ANTHROPIC_API_KEY=replace-me

# --- Per-step model + effort overrides (optional; defaults in backend/app/llm/models.py, PLAN §8.1) ---
# Effort: low | medium | high | none (none = omit the effort parameter)
# IPS_MODEL_CLASSIFY=claude-sonnet-5-5
# IPS_EFFORT_CLASSIFY=low
# IPS_MODEL_EXTRACT=claude-opus-5-5
# IPS_EFFORT_EXTRACT=high
# IPS_MODEL_TERMINOLOGY=claude-sonnet-5-5
# IPS_EFFORT_TERMINOLOGY=medium
# IPS_MODEL_REPAIR=claude-opus-5-5
# IPS_EFFORT_REPAIR=medium
# IPS_MODEL_MERGE=claude-opus-5-5
# IPS_EFFORT_MERGE=high
# IPS_MODEL_EVAL_JUDGE=claude-sonnet-5-5
# IPS_EFFORT_EVAL_JUDGE=medium

# --- Postgres ---
POSTGRES_USER=ips
POSTGRES_PASSWORD=ips-dev-password
POSTGRES_DB=ips
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ips:ips-dev-password@localhost:5432/ips

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO, S3 API) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ips-dev-access
S3_SECRET_KEY=ips-dev-secret-key
S3_BUCKET=ips-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Matchbox (FHIR validator with IPS IG) ---
MATCHBOX_PORT=8080
MATCHBOX_MEMORY_LIMIT=3g
MATCHBOX_URL=http://localhost:8080/matchboxv3/fhir

# --- Terminology server (tx.fhir.org is dev only) ---
TERMINOLOGY_SERVER_URL=https://tx.fhir.org/r4
